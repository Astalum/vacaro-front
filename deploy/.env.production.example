# CI の実行結果に表示される sha-<40桁> タグへ固定します。
# latest は更新対象が曖昧になるため、本番では使用しません。
VACARO_FRONT_IMAGE=ghcr.io/astalum/vacaro-front:sha-0000000000000000000000000000000000000000
VACARO_BACK_IMAGE=ghcr.io/astalum/vacaro-back:sha-0000000000000000000000000000000000000000
VACARO_MIGRATIONS_IMAGE=ghcr.io/astalum/vacaro-back:migrations-sha-0000000000000000000000000000000000000000

# URLへ埋め込むため、POSTGRES_PASSWORDには英数字だけのhex値を推奨します。
# openssl rand -hex 32
POSTGRES_DB=vacaro
POSTGRES_USER=vacaro
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32

# それぞれ別の値を生成します: openssl rand -base64 32
SESSION_KEY=replace_with_openssl_rand_base64_32
TOKEN_ENCRYPTION_KEY=

GUEST_TTL=168h
REGISTERED_SESSION_TTL=720h
PUBLIC_APP_URL=https://vacaro.astalum.dev
ALLOWED_ORIGINS=https://vacaro.astalum.dev
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW=1m
# APIコンテナへ直接接続するリバースプロキシのCIDRだけを設定します。
# 未設定時、X-Forwarded-ForとX-Real-IPは無視されます。
TRUSTED_PROXY_CIDRS=

# Google連携を使う場合は以下をすべて設定します。使わない場合はすべて空にします。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_LOGIN_REDIRECT_URL=https://vacaro.astalum.dev/api/v1/auth/google/callback
# GOOGLE_CALENDAR_REDIRECT_URL=https://vacaro.astalum.dev/api/v1/integrations/google-calendar/callback
GOOGLE_LOGIN_REDIRECT_URL=
GOOGLE_CALENDAR_REDIRECT_URL=
