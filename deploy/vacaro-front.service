[Unit]
Description=Vacaro production containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vacaro
ExecStart=/usr/bin/docker compose --env-file /opt/vacaro/.env.production -f /opt/vacaro/compose.prod.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /opt/vacaro/.env.production -f /opt/vacaro/compose.prod.yaml stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
